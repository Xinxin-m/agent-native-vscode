# Every dashboard has its own private, locally generated library.
data/*
!data/.gitkeep
!data/config.example.json
.file-relocations.json

# Browser-automation snapshots: these transcribe the on-screen page, i.e.
# real chat titles and absolute paths. Never commit them.
.playwright-cli/
output/

__pycache__/
*.py[cod]

# Local installs and build packages
node_modules/
*.vsix
vscode-library/builds/
.DS_Store

# Private project-map runtime state
project-map/output/
project-map/views.json
project-map/folder-discovery.json

# Portable layout: all per-user runtime state stays inside app/.
app/data/*
!app/data/config.example.json
app/output/
app/project-map/output/
app/project-map/views.json
app/project-map/folder-discovery.json
app/vscode-library/builds/

# Reconstructed desktop and local artifacts
desktop/vscode/
desktop/VSCode-*/
desktop/output/
*.app/

# Entry file of the previous client build; its chunks stay until the next build.
workbench/.previous-build.html
app/workbench/.previous-build.html
