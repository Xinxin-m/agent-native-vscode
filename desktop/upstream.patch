+/** Counts files and bytes under a path, following symbolic links like the cross-device copy does. */
+async function measure(path: string, seen = new Set<string>()): Promise<{ files: number; bytes: number }> {
+	const stat = await fs.promises.stat(path);
+	if (!stat.isDirectory()) {
+		return { files: 1, bytes: stat.size };
+	}
+	const real = await fs.promises.realpath(path);
+	if (seen.has(real)) {
+		return { files: 0, bytes: 0 };
+	}
+	seen.add(real);
+	const total = { files: 0, bytes: 0 };
+	for (const name of await fs.promises.readdir(path)) {
+		const child = await measure(join(path, name), seen);
+		total.files += child.files;
+		total.bytes += child.bytes;
+	}
+	return total;
+}
