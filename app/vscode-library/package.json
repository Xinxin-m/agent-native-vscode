{
  "name": "library-workspace",
  "displayName": "Library Chat",
  "description": "Use the existing local Library broker from ordinary VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onUri",
    "onWebviewPanel:library.projectMap"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read conversations; sending, attachments and run controls require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "library.open",
        "title": "Library: Open Chat"
      },
      {
        "command": "library.openProjectMap",
        "title": "Library: Open Project Map"
      },
      {
        "command": "library.copy.reference",
        "title": "Copy reference for an agent"
      },
      {
        "command": "library.copy.session_id",
        "title": "Copy session ID"
      },
      {
        "command": "library.copy.transcript_path",
        "title": "Copy Path"
      },
      {
        "command": "library.copy.resume_command",
        "title": "Copy resume command"
      }
    ],
    "configuration": {
      "title": "Library Chat",
      "properties": {
        "library.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8744",
          "scope": "application",
          "description": "Existing Library HTTP loopback origin. This extension never starts a broker or provider."
        }
      }
    },
    "menus": {
      "editor/title/context": [
        {
          "command": "library.copy.reference",
          "when": "activeWebviewPanelId == libraryChat",
          "group": "1_library_reference@0"
        },
        {
          "command": "library.copy.session_id",
          "when": "activeWebviewPanelId == libraryChat",
          "group": "1_library_reference@1"
        },
        {
          "command": "library.copy.transcript_path",
          "when": "activeWebviewPanelId == libraryChat",
          "group": "0_library_path"
        },
        {
          "command": "library.copy.resume_command",
          "when": "activeWebviewPanelId == libraryChat",
          "group": "1_library_reference@3"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "python3 package.py"
  },
  "license": "MIT"
}
